VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-key

# Server-only Vercel variables. Never prefix these with VITE_ and never ship
# them in the React bundle.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-service-role-key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
MESSAGE_WEBHOOK_SECRET=generate-a-long-random-webhook-secret
